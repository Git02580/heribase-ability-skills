{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heribase.local/schemas/manifest.schema.json",
  "title": "HeriBase task manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_key", "display_name", "description", "created_at", "created_timezone", "updated_at", "revision", "dataset_revision", "state", "data_health", "schema_versions", "statistics", "dataset_fingerprint", "created_by"],
  "properties": {
    "schema_version": {"const": "heribase.task-manifest.v1"},
    "task_key": {"type": "string", "pattern": "^[0-9]{8}-[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*(?:-[0-9]{2})?$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 200},
    "description": {"type": "string", "maxLength": 2000},
    "created_at": {"type": "string", "format": "date-time"},
    "created_timezone": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "revision": {"type": "integer", "minimum": 1},
    "dataset_revision": {"type": "integer", "minimum": 1},
    "state": {"enum": ["received", "indexing", "grouping", "awaiting_precheck", "identification_pending", "identifying", "identification_review", "awaiting_collection_confirmation", "collecting", "completed", "completed_with_exceptions", "cancelled", "data_inconsistent"]},
    "data_health": {"enum": ["healthy", "incomplete", "inconsistent", "recovery_required"]},
    "schema_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "items", "identified", "reviewed", "collect", "need_photo", "excluded", "collected", "exceptions"],
      "properties": {
        "sources": {"type": "integer", "minimum": 0},
        "items": {"type": "integer", "minimum": 0},
        "identified": {"type": "integer", "minimum": 0},
        "reviewed": {"type": "integer", "minimum": 0},
        "collect": {"type": "integer", "minimum": 0},
        "need_photo": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0},
        "collected": {"type": "integer", "minimum": 0},
        "exceptions": {"type": "integer", "minimum": 0}
      }
    },
    "dataset_fingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "created_by": {"type": "object", "required": ["type", "name"], "properties": {"type": {"enum": ["user", "agent", "migration"]}, "name": {"type": "string", "minLength": 1}}, "additionalProperties": true}
  }
}
