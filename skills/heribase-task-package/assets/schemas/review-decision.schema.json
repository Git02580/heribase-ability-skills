{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heribase.local/schemas/review-decision.schema.json",
  "title": "HeriBase review decision v1",
  "type": "object",
  "required": ["schema_version", "decision_id", "task_key", "local_id", "action", "decision", "note", "actor", "interaction", "based_on", "supersedes", "reverts", "created_at", "sequence", "previous_event_sha256", "event_sha256"],
  "properties": {
    "schema_version": {"const": "heribase.review-decision.v1"},
    "decision_id": {"type": "string", "minLength": 1},
    "task_key": {"type": "string"},
    "local_id": {"type": "string"},
    "action": {"enum": ["set", "clear", "revert"]},
    "decision": {"enum": ["collect", "need_photo", "exclude", null]},
    "note": {"type": ["string", "null"]},
    "actor": {"type": "object", "required": ["type", "name"], "properties": {"type": {"enum": ["user", "agent", "import"]}, "name": {"type": "string"}}, "additionalProperties": true},
    "interaction": {"type": "object", "required": ["source", "batch_action_id", "import_ref"], "properties": {"source": {"enum": ["single", "bulk", "import"]}, "batch_action_id": {"type": ["string", "null"]}, "import_ref": {"type": ["string", "null"]}}, "additionalProperties": false},
    "based_on": {"type": "object", "required": ["item_version", "identification_snapshot_id", "dataset_revision", "dataset_fingerprint"], "properties": {"item_version": {"type": "integer", "minimum": 1}, "identification_snapshot_id": {"type": ["string", "null"]}, "dataset_revision": {"type": "integer", "minimum": 1}, "dataset_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "supersedes": {"type": ["string", "null"]},
    "reverts": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "sequence": {"type": "integer", "minimum": 1},
    "previous_event_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "event_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"action": {"const": "set"}}}, "then": {"properties": {"decision": {"enum": ["collect", "need_photo", "exclude"]}}}},
    {"if": {"properties": {"action": {"enum": ["clear", "revert"]}}}, "then": {"properties": {"decision": {"type": "null"}}}}
  ]
}
